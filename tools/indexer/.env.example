# Sao chép thành .env (KHÔNG commit). Lấy trong Cloudflare: R2 -> Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Thư mục nhạc gốc trên PC, ví dụ D:/Music
MUSIC_SOURCE_DIR=
# Thư mục nhận file nhập từ dashboard (Phase 4). Mặc định: <MUSIC_SOURCE_DIR>/_imported
MUSIC_IMPORT_DIR=
